GCP_PROJECT_ID=REPLACE_WITH_GCP_PROJECT_ID
BIGQUERY_DATASET=REPLACE_WITH_BIGQUERY_DATASET
BIGQUERY_LOCATION=US
GOOGLE_APPLICATION_CREDENTIALS=REPLACE_WITH_ABSOLUTE_PATH_TO_SERVICE_ACCOUNT_JSON
# Alternative to file path: paste full JSON object as a single line string.
GCP_SA_KEY_JSON=

AMAZON_REPO_ID=McAuley-Lab/Amazon-Reviews-2023
AMAZON_HOME_KITCHEN_REVIEW_PATH=raw/review_categories/Home_and_Kitchen.jsonl
AMAZON_HOME_KITCHEN_META_PATH=raw/meta_categories/meta_Home_and_Kitchen.jsonl

# Local two-pass ingest (paths relative to repo root when not absolute)
STAGE1_USE_LOCAL_FILES=false
STAGE1_LOCAL_REVIEWS_PATH=seller-copilot/data/raw/amazon_reviews_2023/Home_and_Kitchen.jsonl
STAGE1_LOCAL_META_PATH=seller-copilot/data/raw/amazon_reviews_2023/meta_Home_and_Kitchen.jsonl

STAGE1_MAX_REVIEWS=800000
STAGE1_MAX_META=200000
STAGE1_MIN_REVIEWS_PER_PRODUCT=15
STAGE1_MIN_TITLE_CHARS=8
STAGE1_MIN_REVIEW_CHARS=30
STAGE1_MIN_PRICE_PERCENTILE=0.01
STAGE1_MAX_PRICE_PERCENTILE=0.99
STAGE1_MAX_PRODUCTS=100000
STAGE1_RECENT_YEAR_FLOOR=2018
STAGE1_RESET_BIGQUERY_TABLES=true
# true = load BigQuery after curation; false = local Parquet only (see config/stage1_local_agent.yaml)
STAGE1_REQUIRE_BIGQUERY=true
# Override output folder for the agent bundle (products/reviews/signals/retrieval + manifest)
STAGE1_AGENT_DATASET_DIR=seller-copilot/data/agent_dataset
